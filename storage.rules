rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }
    function isDm() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email == 'dm@thalarion-69cd1.firebaseapp.com';
    }
    function isPlayerMail() {
      return signedIn()
        && request.auth.token.email.matches('player-.*@thalarion-69cd1[.]firebaseapp[.]com');
    }

    match /images/{allPaths=**} {
      allow read: if signedIn();
      allow write: if isDm() || isPlayerMail();
    }
  }
}
